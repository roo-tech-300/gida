{
  "buildCommand": "npx expo export --platform web && node scripts/copy-public-assets.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/onboarding", "destination": "/" },
    { "source": "/property/:path*", "destination": "/" },
    { "source": "/roommate/:path*", "destination": "/" },
    { "source": "/messages/:path*", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" }
  ]
}
