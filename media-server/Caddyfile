{$MEDIA_DOMAIN} {
	# Finished videos. Every video lives in its own UUID folder that never
	# changes once published, so the CDN and players may cache it forever.
	handle /v/* {
		root * /srv/media/public

		header {
			Cache-Control "public, max-age=31536000, immutable"
			Access-Control-Allow-Origin "*"
			X-Content-Type-Options "nosniff"
		}
		@playlist path *.m3u8
		header @playlist Content-Type "application/vnd.apple.mpegurl"
		@segment path *.ts
		header @segment Content-Type "video/mp2t"

		# Deleted or not-yet-published videos must not be cached for a year.
		@missing not file
		handle @missing {
			header Cache-Control "no-store"
			respond 404
		}

		file_server
	}

	# Uploads, deletes and health checks go to the Node service.
	handle {
		reverse_proxy media-server:3000 {
			# tus relies on these to build the upload URL it hands back.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
}
