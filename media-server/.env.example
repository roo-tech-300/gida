# Domain pointing at this VPS (Caddy gets the HTTPS certificate automatically).
MEDIA_DOMAIN=media.example.com

SUPABASE_URL=https://your-project.supabase.co
# Service role key: bypasses RLS. Never ship it in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to upload from a browser (Expo web build).
# Native apps don't send an Origin header and are unaffected.
ALLOWED_ORIGINS=https://gida.example.com

# Optional limits (defaults shown).
# MAX_UPLOAD_MB=500
# MAX_DURATION_SECONDS=180
# MAX_VIDEOS_PER_LISTING=3
# TRANSCODE_CPUS=3
